# EventPulse24 local configuration. Copy to .env (`make env`) and adjust per machine.
# .env is git-ignored. These are LOCAL-ONLY defaults — never reuse them anywhere else.
# Values must not contain `$` or `#`: the Makefile includes .env, and make expands `$`
# and treats `#` as the start of a comment.

# --- Host ports (change any that clash on your machine; `make doctor` checks them) ---
EP_PG_PORT=5440
EP_REDIS_PORT=6380
EP_SMTP_PORT=1025
EP_MAILPIT_UI_PORT=8025
EP_MINIO_PORT=9000
EP_MINIO_CONSOLE_PORT=9001
API_PORT=8000
WEB_PORT=3000
# Where Next.js forwards the browser's /api/* calls (frontend/proxy.ts). An origin, no path;
# read per request, so changing it needs no frontend rebuild. Keep in sync with API_PORT.
API_BASE_URL=http://127.0.0.1:8000

# --- Django ---
# Local-only key; production keys come from the platform secret store.
DJANGO_SECRET_KEY=local-dev-only-3f9c2a7e1b8d4f6a9c0e5b2d7a1f4c8e-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# The frontend's origins, which Django's CSRF check must trust. The browser sends its own
# origin (the Next.js port) and the proxy forwards it, while Django's host is API_PORT, so
# without this every POST through the proxy is refused with 403 csrf_failed. Keep in sync
# with WEB_PORT. Production sets the site's own origin.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# runtime = DML-only roles (the app). `make migrate` switches to owner for DDL.
DJANGO_DB_ROLE=runtime

# --- Calendar credentials (AD-18) ---
# The application-level key the calendar credential is encrypted with: a key id and a
# base64url-encoded 32-byte key. Separate from DJANGO_SECRET_KEY on purpose -- one leaked
# session key must not decrypt every stored calendar credential.
# This value is local-only and must be replaced in production (secret store).
CALENDAR_CREDENTIAL_KEY=k1.ZXZlbnRwdWxzZTI0LWxvY2FsLWNyZWRrZXktMzJieXQ

# --- Revalidation (FR-26, FR-27) ---
# The shared secret that authenticates the backend's revalidation call to the frontend.
# Separate from CALENDAR_CREDENTIAL_KEY on purpose: one key per capability, and the
# calendar key is encrypted at rest (AD-18) so it cannot be compared in plaintext.
# This value is local-only and must be replaced in production (secret store).
REVALIDATION_SECRET=local-dev-only-revalidation-secret-not-for-production
# The frontend's revalidation route, server-to-server. Not NEXT_PUBLIC_-prefixed: the
# backend dials the frontend, so it needs the server's address, not the browser's.
FRONTEND_REVALIDATION_URL=http://localhost:3000/revalidate

# --- The site's public origin ---
# The address a share card and a canonical link name. Next resolves a relative OG image
# against this, and without it falls back to http://localhost:3000 -- so a share card
# would point its image at localhost and show nothing. Keep it in sync with WEB_PORT.
# This is the PUBLIC origin, not the server-to-server one: in a deployment the Next.js
# server's own address is often internal, while this is what the outside world sees.
PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- Postgres (Docker) ---
EP_DB_NAME=eventpulse24
EP_PG_SUPERUSER_PASSWORD=postgres_local
EP_OWNER_PASSWORD=ep_owner_local
EP_CATALOG_PASSWORD=ep_catalog_local
EP_PERSONAL_PASSWORD=ep_personal_local

# Connection URLs used by the app. Keep host/port in sync with EP_PG_PORT above.
# To use a native PostgreSQL 18 + pgvector instead of Docker, point these at it
# (and run docker/postgres/init/01-schemas-and-roles.sh against it once).
DATABASE_URL_OWNER=postgresql://ep_owner:ep_owner_local@127.0.0.1:5440/eventpulse24
DATABASE_URL_CATALOG=postgresql://ep_catalog:ep_catalog_local@127.0.0.1:5440/eventpulse24
DATABASE_URL_PERSONAL=postgresql://ep_personal:ep_personal_local@127.0.0.1:5440/eventpulse24

# --- Redis (Celery broker; keep port in sync with EP_REDIS_PORT) ---
REDIS_URL=redis://127.0.0.1:6380/0

# --- Email (Mailpit catches everything locally) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# --- External services ---
# fake = local stand-ins for LLM, embeddings, email provider and billing; no API keys needed.
ADAPTER_MODE=fake

# --- Calendar importer ---
# CALENDAR_ADAPTER overrides ADAPTER_MODE for the calendar port alone. Unset (the default) it
# follows the mode, which locally means the fake: it returns the same two events — "Team
# stand-up" and "Dinner", dated 2 Nov 2026 — for EVERY address, whatever calendar you paste.
#
# That fake is the one stand-in you cannot see from the UI. The connection reads `active`, the
# last-synced time is recent, there is no error anywhere, and two perfectly well-formed events
# appear that are simply not yours. The only tell is the event uids
# (`fake-standup@eventpulse24.local`).
#
# To import a REAL calendar locally, set both of these. `ics` alone is refused at boot,
# because the ICS adapter does not open its own socket — it fetches through the shared
# source-fetch port, so a fake one would hand it fixture data for every address:
#
#   CALENDAR_ADAPTER=ics
#   SOURCE_FETCH=http
#
# Note that SOURCE_FETCH=http also makes source ingestion crawl real feeds: it is one port.
# CALENDAR_ADAPTER=ics

# --- Throttle counter store ---
# This one port overrides ADAPTER_MODE, and it has to: the counters are the product's rate
# limits and the save cap, and they are read by the API, spent by the API and cleared by
# the seed command — three separate processes that must see one set of numbers. An
# in-process store gives each its own copy, so the seed's allowance reset never reaches
# the API and the second run of a suite finds the cap already spent. Redis is already in
# the stack (it is the Celery broker); the rate limits themselves are unchanged.
# Unset: follow ADAPTER_MODE. memory: keep the counters in-process, at the cost of the
# sharing described above.
THROTTLE_ADAPTER=redis

# --- Source fetching ---
# Unset: follow ADAPTER_MODE (fake = recorded fixtures in backend/tests/fixtures/sources).
# http: fetch real feeds over the network while every other adapter stays fake. The fetcher
# only reaches public addresses on ports 80/443 and never follows a redirect to another host.
# SOURCE_FETCH=http
# SOURCE_FETCH_USER_AGENT=EventPulse24-SourceFetcher/0.1 (+https://github.com/JobaerAhamed-23/EventPulse24)

# --- Billing (FR-48) -------------------------------------------------------------
# Stripe test-mode values. These are local-only placeholders and must be replaced from the
# platform secret store in production. The API key authorises calls out to Stripe; the
# webhook secret verifies calls in. They are separate on purpose and rotate independently.
STRIPE_API_KEY=sk_test_local-dev-only-not-a-real-key
STRIPE_WEBHOOK_SECRET=whsec_local-dev-only-not-a-real-secret
# Price ids differ between test and live mode, so they are configuration, not literals.
STRIPE_PRICE_MONTHLY=price_local_monthly
STRIPE_PRICE_YEARLY=price_local_yearly

# --- Embeddings (FR-25) ------------------------------------------------------------
# Voyage's API key, for the real embedding adapter. This is a local-only placeholder and
# must be replaced from the platform secret store in production. The key authorises calls
# out to Voyage's embedding endpoint.
VOYAGE_API_KEY=pa_local-dev-only-not-a-real-key

# FR-17: Ticketmaster Discovery, for api-method sources. Optional — leave it empty and
# no API-tier source can be provisioned; everything else runs. Get one at
# https://developer.ticketmaster.com/. It travels as an `apikey=` query parameter, so the
# fetch URL is treated as a credential and is never written to the database or a log.
TICKETMASTER_API_KEY=
# How long the backend waits for Voyage to answer an embedding call, in seconds.
VOYAGE_TIMEOUT_SECONDS=30.0

# --- Object storage (ports.blob) ---
# Where profile pictures live. Local-only credentials; production reads these from the
# platform secret store, like every other credential in this file.
#
# TWO ENDPOINTS, and they are not the same address. BLOB_ENDPOINT is what the API dials:
# inside the compose network the store answers to its service name. BLOB_PUBLIC_ENDPOINT
# is the address a presigned URL is minted for, which the BROWSER dials, and a SigV4
# signature is bound to the host it was signed for. Getting these the wrong way round
# produces a URL that every backend test accepts and no browser can fetch. In a
# deployment where the store has one address, both carry it.
#
# The app processes run on the host here (hybrid dev), so both are 127.0.0.1 locally.
BLOB_ENDPOINT=http://127.0.0.1:9000
BLOB_PUBLIC_ENDPOINT=http://127.0.0.1:9000
BLOB_REGION=us-east-1
BLOB_BUCKET=eventpulse24-blobs
BLOB_ACCESS_KEY=eventpulse_local
BLOB_SECRET_KEY=eventpulse_local_secret
# How long a presigned URL is good for. Short on purpose: it is the inside of a stable
# app-owned URL, not something a page is rendered with.
BLOB_URL_TTL_SECONDS=300
# Which adapter serves ports.blob: `s3` (the local store, and production) or `memory`
# (nothing kept across a restart). Unset follows ADAPTER_MODE, which means `s3`.
# BLOB_ADAPTER=s3
