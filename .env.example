# EventPulse24 local configuration. Copy to .env (`make env`) and adjust per machine.
# .env is git-ignored. These are LOCAL-ONLY defaults — never reuse them anywhere else.
# Values must not contain `$` or `#`: the Makefile includes .env, and make expands `$`
# and treats `#` as the start of a comment.

# --- Host ports (change any that clash on your machine; `make doctor` checks them) ---
EP_PG_PORT=5440
EP_REDIS_PORT=6380
EP_SMTP_PORT=1025
EP_MAILPIT_UI_PORT=8025
API_PORT=8000
WEB_PORT=3000
# Where Next.js forwards the browser's /api/* calls (frontend/proxy.ts). An origin, no path;
# read per request, so changing it needs no frontend rebuild. Keep in sync with API_PORT.
API_BASE_URL=http://127.0.0.1:8000

# --- Django ---
# Local-only key; production keys come from the platform secret store.
DJANGO_SECRET_KEY=local-dev-only-3f9c2a7e1b8d4f6a9c0e5b2d7a1f4c8e-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# runtime = DML-only roles (the app). `make migrate` switches to owner for DDL.
DJANGO_DB_ROLE=runtime

# --- Calendar credentials (AD-18) ---
# The application-level key the calendar credential is encrypted with: a key id and a
# base64url-encoded 32-byte key. Separate from DJANGO_SECRET_KEY on purpose -- one leaked
# session key must not decrypt every stored calendar credential.
# This value is local-only and must be replaced in production (secret store).
CALENDAR_CREDENTIAL_KEY=k1.ZXZlbnRwdWxzZTI0LWxvY2FsLWNyZWRrZXktMzJieXQ

# --- Postgres (Docker) ---
EP_DB_NAME=eventpulse24
EP_PG_SUPERUSER_PASSWORD=postgres_local
EP_OWNER_PASSWORD=ep_owner_local
EP_CATALOG_PASSWORD=ep_catalog_local
EP_PERSONAL_PASSWORD=ep_personal_local

# Connection URLs used by the app. Keep host/port in sync with EP_PG_PORT above.
# To use a native PostgreSQL 18 + pgvector instead of Docker, point these at it
# (and run docker/postgres/init/01-schemas-and-roles.sh against it once).
DATABASE_URL_OWNER=postgresql://ep_owner:ep_owner_local@127.0.0.1:5440/eventpulse24
DATABASE_URL_CATALOG=postgresql://ep_catalog:ep_catalog_local@127.0.0.1:5440/eventpulse24
DATABASE_URL_PERSONAL=postgresql://ep_personal:ep_personal_local@127.0.0.1:5440/eventpulse24

# --- Redis (Celery broker; keep port in sync with EP_REDIS_PORT) ---
REDIS_URL=redis://127.0.0.1:6380/0

# --- Email (Mailpit catches everything locally) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# --- External services ---
# fake = local stand-ins for LLM, embeddings, email provider and billing; no API keys needed.
ADAPTER_MODE=fake

# --- Source fetching ---
# Unset: follow ADAPTER_MODE (fake = recorded fixtures in backend/tests/fixtures/sources).
# http: fetch real feeds over the network while every other adapter stays fake. The fetcher
# only reaches public addresses on ports 80/443 and never follows a redirect to another host.
# SOURCE_FETCH=http
# SOURCE_FETCH_USER_AGENT=EventPulse24-SourceFetcher/0.1 (+https://github.com/JobaerAhamed-23/EventPulse24)
