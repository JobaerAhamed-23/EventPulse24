{
  "components": {
    "schemas": {
      "ComponentOut": {
        "properties": {
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "unreachable",
                  "wrong_schema"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "enum": [
              "ok",
              "down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ComponentOut",
        "type": "object"
      },
      "ComponentsOut": {
        "properties": {
          "catalog": {
            "$ref": "#/components/schemas/ComponentOut"
          },
          "personal": {
            "$ref": "#/components/schemas/ComponentOut"
          },
          "redis": {
            "$ref": "#/components/schemas/ComponentOut"
          }
        },
        "required": [
          "personal",
          "catalog",
          "redis"
        ],
        "title": "ComponentsOut",
        "type": "object"
      },
      "ConflictOut": {
        "description": "One conflict the user must answer.\n\n`actions` is the closed set of three choices for this conflict's kind. `dismiss` is not\namong them and cannot be expressed.",
        "properties": {
          "actions": {
            "items": {
              "type": "string"
            },
            "title": "Actions",
            "type": "array"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "other": {
            "$ref": "#/components/schemas/ConflictSideOut"
          },
          "pair_id": {
            "format": "uuid",
            "title": "Pair Id",
            "type": "string"
          }
        },
        "required": [
          "pair_id",
          "kind",
          "other",
          "actions"
        ],
        "title": "ConflictOut",
        "type": "object"
      },
      "ConflictResolutionIn": {
        "description": "The body of a resolution: which of the three, and which event is the new one.\n\n`new_side_id` is required because the pair row is **symmetric** — it stores both sides\nsorted, so the row cannot say which side the user just created. The prompt's asymmetry\nlives in the client (it knows which event it just made) and comes back here.\n\nThe body carries the id only, not the kind: this endpoint resolves conflicts *on\npersonal events*, so the new side is a personal event by definition. That keeps the\nshape narrow — a client cannot name a saved event's id and have it deleted.",
        "properties": {
          "new_side_id": {
            "format": "uuid",
            "title": "New Side Id",
            "type": "string"
          },
          "resolution": {
            "enum": [
              "keep_both",
              "edit_new",
              "update_existing",
              "delete_new"
            ],
            "title": "Resolution",
            "type": "string"
          }
        },
        "required": [
          "resolution",
          "new_side_id"
        ],
        "title": "ConflictResolutionIn",
        "type": "object"
      },
      "ConflictResolutionOut": {
        "description": "The outcome of a resolution.\n\n`new_side_id` is the event the prompt called \"new\" — the client opens it in edit mode\nfor `edit_new`, or finds it already deleted for `delete_new`.",
        "properties": {
          "existing_side_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Existing Side Id"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "new_side_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "New Side Id"
          },
          "pair_id": {
            "format": "uuid",
            "title": "Pair Id",
            "type": "string"
          },
          "resolution": {
            "title": "Resolution",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "pair_id",
          "kind",
          "resolution",
          "status"
        ],
        "title": "ConflictResolutionOut",
        "type": "object"
      },
      "ConflictSideOut": {
        "description": "One side of a conflict: the event that clashes.\n\nThe times are UTC instants. The side does not carry a timezone of its own — the sides\nare two records that may live in two different zones, and a conflict is about the\ninstants they occupy, not about how either is displayed.",
        "properties": {
          "end_time_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time Utc"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "start_time_utc": {
            "format": "date-time",
            "title": "Start Time Utc",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "start_time_utc"
        ],
        "title": "ConflictSideOut",
        "type": "object"
      },
      "ErrorOut": {
        "description": "`{code, message, details?}`. Validation errors use `details = {\"errors\": [ErrorItem]}`.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "EventListOut": {
        "description": "One page of the public catalog, and what the frontend needs to page through it.",
        "properties": {
          "has_next": {
            "title": "Has Next",
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/EventOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "page_size",
          "total",
          "has_next"
        ],
        "title": "EventListOut",
        "type": "object"
      },
      "EventOut": {
        "description": "One public event.\n\n`id` is the stable identifier the API is keyed by; `slug` is the public page route's\nkey (the spine's Ids convention: a page URL uses the slug, never the PK).",
        "properties": {
          "canonical_url": {
            "title": "Canonical Url",
            "type": "string"
          },
          "end_time_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time Utc"
          },
          "event_version": {
            "title": "Event Version",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "source_name": {
            "title": "Source Name",
            "type": "string"
          },
          "start_time_tz": {
            "title": "Start Time Tz",
            "type": "string"
          },
          "start_time_utc": {
            "format": "date-time",
            "title": "Start Time Utc",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "tz_review_pending": {
            "default": false,
            "title": "Tz Review Pending",
            "type": "boolean"
          },
          "venue_city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue City"
          },
          "venue_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue Name"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "canonical_url",
          "start_time_utc",
          "start_time_tz",
          "status",
          "event_version",
          "source_name"
        ],
        "title": "EventOut",
        "type": "object"
      },
      "EventPage": {
        "description": "The list endpoint's query parameters.\n\n`city` matches the venue's city exactly, case-insensitively. The date bounds are\ninclusive and apply to the start time.",
        "properties": {
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "page": {
            "default": 1,
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Page Size",
            "type": "integer"
          },
          "starts_after": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts After"
          },
          "starts_before": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts Before"
          }
        },
        "title": "EventPage",
        "type": "object"
      },
      "HealthDetails": {
        "properties": {
          "components": {
            "$ref": "#/components/schemas/ComponentsOut"
          }
        },
        "required": [
          "components"
        ],
        "title": "HealthDetails",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "components": {
            "$ref": "#/components/schemas/ComponentsOut"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "components"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "HealthUnavailableOut": {
        "description": "The shared error shape, with the per-component details typed for the client.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "$ref": "#/components/schemas/HealthDetails"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "HealthUnavailableOut",
        "type": "object"
      },
      "PersonalEventCreateIn": {
        "description": "The body of a create.\n\nThe IANA timezone is **required**: a floating local time is refused rather than guessed,\nbecause the user's wall clock and the event's zone are not the same thing.",
        "properties": {
          "end_time_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time Utc"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "start_time_tz": {
            "title": "Start Time Tz",
            "type": "string"
          },
          "start_time_utc": {
            "format": "date-time",
            "title": "Start Time Utc",
            "type": "string"
          }
        },
        "required": [
          "name",
          "start_time_utc",
          "start_time_tz"
        ],
        "title": "PersonalEventCreateIn",
        "type": "object"
      },
      "PersonalEventListOut": {
        "description": "The user's own personal events, soonest first.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PersonalEventOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "PersonalEventListOut",
        "type": "object"
      },
      "PersonalEventListQuery": {
        "description": "The query parameters of the list endpoint.\n\nThis is a **separate** schema from `PersonalEventListOut`, and it has to be. A\nschema-typed argument is a request *body* unless it is wrapped in `Query(...)`; and the\nresponse schema has no bounds on it, so using it as the query model would silently\naccept `?starts_after=…` and then ignore it.\n\nThe bounds are inclusive and apply to the start time. Both are optional: with neither,\nthe list is every event the user has.",
        "properties": {
          "starts_after": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts After"
          },
          "starts_before": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts Before"
          }
        },
        "title": "PersonalEventListQuery",
        "type": "object"
      },
      "PersonalEventOut": {
        "description": "One personal event.\n\n`version` rises by one on every edit (AD-7's send key uses it, so it may only go up).",
        "properties": {
          "end_time_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time Utc"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "start_time_tz": {
            "title": "Start Time Tz",
            "type": "string"
          },
          "start_time_utc": {
            "format": "date-time",
            "title": "Start Time Utc",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "start_time_utc",
          "start_time_tz",
          "version"
        ],
        "title": "PersonalEventOut",
        "type": "object"
      },
      "PersonalEventPatchIn": {
        "description": "The body of an edit. Every field is optional — an edit changes only what it names.\n\nA field left out is unchanged. There is no way to *clear* `location` or `notes` through\nthis shape, because `None` and \"not mentioned\" are the same value here; that is a\ndeliberate limitation of a first-cut edit endpoint, not an oversight.",
        "properties": {
          "end_time_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time Utc"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "name": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "start_time_tz": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Time Tz"
          },
          "start_time_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Time Utc"
          }
        },
        "title": "PersonalEventPatchIn",
        "type": "object"
      },
      "SchedulingConflictDetails": {
        "description": "The `details` of a 409: which event was written, and what it clashes with.",
        "properties": {
          "conflicts": {
            "items": {
              "$ref": "#/components/schemas/ConflictOut"
            },
            "title": "Conflicts",
            "type": "array"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "conflicts"
        ],
        "title": "SchedulingConflictDetails",
        "type": "object"
      },
      "SchedulingConflictOut": {
        "description": "The 409 a conflicting create or edit answers with.\n\nIt is an `ErrorOut` — `{code, message, details?}` — with the `details` field\n**narrowed** to the conflict payload. That narrowing is the point: the client has to\nrender the three actions (FR-58), so the shape of the conflict has to be in the\ngenerated contract, not just in the prose of the description. With the plain `ErrorOut`\nthe `details` would be an untyped dictionary, and a client generated from the OpenAPI\ndocument could not read a single field of it.\n\nThe message and code come from `domain.errors.SchedulingConflictError`; the API layer\nbuilds the body, so the two stay in step through this schema.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SchedulingConflictDetails"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "SchedulingConflictOut",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "",
    "title": "EventPulse24 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/catalog/events": {
      "get": {
        "description": "Published, non-superseded events that have not started yet, soonest first. Optional city and date-range filters. No session is used and none is set.",
        "operationId": "apps_catalog_api_list_events",
        "parameters": [
          {
            "in": "query",
            "name": "city",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "City"
            }
          },
          {
            "in": "query",
            "name": "starts_after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Starts After"
            }
          },
          {
            "in": "query",
            "name": "starts_before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Starts Before"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventListOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List upcoming public events",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/catalog/events/{event_id}": {
      "get": {
        "description": "One published event by id. An event that is not public reads as not found. No session is used and none is set.",
        "operationId": "apps_catalog_api_get_event",
        "parameters": [
          {
            "in": "path",
            "name": "event_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Event Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventOut"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Get one public event",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "config_health_health",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailableOut"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/personal/events": {
      "get": {
        "description": "The user's own personal events, soonest first. No one else's are listed.",
        "operationId": "apps_personalization_api_list_events",
        "parameters": [
          {
            "in": "query",
            "name": "starts_after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Starts After"
            }
          },
          {
            "in": "query",
            "name": "starts_before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
