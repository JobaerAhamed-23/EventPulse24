{
  "components": {
    "schemas": {
      "ComponentOut": {
        "properties": {
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "unreachable",
                  "wrong_schema"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "enum": [
              "ok",
              "down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ComponentOut",
        "type": "object"
      },
      "ComponentsOut": {
        "properties": {
          "catalog": {
            "$ref": "#/components/schemas/ComponentOut"
          },
          "personal": {
            "$ref": "#/components/schemas/ComponentOut"
          },
          "redis": {
            "$ref": "#/components/schemas/ComponentOut"
          }
        },
        "required": [
          "personal",
          "catalog",
          "redis"
        ],
        "title": "ComponentsOut",
        "type": "object"
      },
      "ErrorOut": {
        "description": "`{code, message, details?}`. Validation errors use `details = {\"errors\": [ErrorItem]}`.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "EventListOut": {
        "description": "One page of the public catalog, and what the frontend needs to page through it.",
        "properties": {
          "has_next": {
            "title": "Has Next",
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/EventOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "page_size",
          "total",
          "has_next"
        ],
        "title": "EventListOut",
        "type": "object"
      },
      "EventOut": {
        "description": "One public event.\n\n`id` is the stable identifier the API is keyed by; `slug` is the public page route's\nkey (the spine's Ids convention: a page URL uses the slug, never the PK).",
        "properties": {
          "canonical_url": {
            "title": "Canonical Url",
            "type": "string"
          },
          "end_time_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time Utc"
          },
          "event_version": {
            "title": "Event Version",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "source_name": {
            "title": "Source Name",
            "type": "string"
          },
          "start_time_tz": {
            "title": "Start Time Tz",
            "type": "string"
          },
          "start_time_utc": {
            "format": "date-time",
            "title": "Start Time Utc",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "tz_review_pending": {
            "default": false,
            "title": "Tz Review Pending",
            "type": "boolean"
          },
          "venue_city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue City"
          },
          "venue_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue Name"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "canonical_url",
          "start_time_utc",
          "start_time_tz",
          "status",
          "event_version",
          "source_name"
        ],
        "title": "EventOut",
        "type": "object"
      },
      "EventPage": {
        "description": "The list endpoint's query parameters.\n\n`city` matches the venue's city exactly, case-insensitively. The date bounds are\ninclusive and apply to the start time.",
        "properties": {
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "page": {
            "default": 1,
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Page Size",
            "type": "integer"
          },
          "starts_after": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts After"
          },
          "starts_before": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts Before"
          }
        },
        "title": "EventPage",
        "type": "object"
      },
      "HealthDetails": {
        "properties": {
          "components": {
            "$ref": "#/components/schemas/ComponentsOut"
          }
        },
        "required": [
          "components"
        ],
        "title": "HealthDetails",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "components": {
            "$ref": "#/components/schemas/ComponentsOut"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "components"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "HealthUnavailableOut": {
        "description": "The shared error shape, with the per-component details typed for the client.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "$ref": "#/components/schemas/HealthDetails"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "HealthUnavailableOut",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "",
    "title": "EventPulse24 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/catalog/events": {
      "get": {
        "description": "Published, non-superseded events that have not started yet, soonest first. Optional city and date-range filters. No session is used and none is set.",
        "operationId": "apps_catalog_api_list_events",
        "parameters": [
          {
            "in": "query",
            "name": "city",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "City"
            }
          },
          {
            "in": "query",
            "name": "starts_after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Starts After"
            }
          },
          {
            "in": "query",
            "name": "starts_before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Starts Before"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventListOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List upcoming public events",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/catalog/events/{event_id}": {
      "get": {
        "description": "One published event by id. An event that is not public reads as not found. No session is used and none is set.",
        "operationId": "apps_catalog_api_get_event",
        "parameters": [
          {
            "in": "path",
            "name": "event_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Event Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventOut"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Get one public event",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "config_health_health",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailableOut"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": []
}