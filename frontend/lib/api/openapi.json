                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "enum": [
              "ok",
              "down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ComponentOut",
        "type": "object"
      },
      "ComponentsOut": {
        "properties": {
          "catalog": {
            "$ref": "#/components/schemas/ComponentOut"
          },
          "personal": {
            "$ref": "#/components/schemas/ComponentOut"
          },
          "redis": {
            "$ref": "#/components/schemas/ComponentOut"
          }
        },
        "required": [
          "personal",
          "catalog",
          "redis"
        ],
        "title": "ComponentsOut",
        "type": "object"
      },
      "HealthDetails": {
        "properties": {
          "components": {
            "$ref": "#/components/schemas/ComponentsOut"
          }
        },
        "required": [
          "components"
        ],
        "title": "HealthDetails",
        "type": "object"
      },
      "HealthOut": {
