            "title": "Code",
            "type": "string"
          },
          "details": {
            "$ref": "#/components/schemas/HealthDetails"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "HealthUnavailableOut",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "",
    "title": "EventPulse24 API",
    "version": "0.1.0"
  },
